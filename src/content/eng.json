      {
        "id": "proj-programada",
        "title": "ProgramADA",
        "sections": [
          {
            "id": "description",
            "content": [
              {
                "type": "text",
                "text": "Game developed in partnership with UFJF's ProgramADA Professional Training Project."
              },
              {
                "type": "text",
                "text": "This project aimed to develop an RPG game set on the university campus. You play as ADA, a freshman student in the Computer Science program. During gameplay, you learn more about classes, explore the campus, consult notes from algorithm classes, and test your knowledge about the degree in a playful way through minigames. The goal is to encourage women in the program not to drop out of college and to feel represented at the university."
              },
              {
                "type": "text",
                "text": "I led the technical development of the project, actively participating from initial ideation through architecture definition and design decisions."
              }
            ]
          },
          {
            "id": "tech",
            "content": [
              {
