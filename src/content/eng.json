  "about": {
    "label": "About Me",
    "sections": [
      {
        "id": "about-me-text",
        "content": [
          {
            "type": "text",
            "text": "Software Engineer driven by excellence and guided by the conviction that developing software means identifying and solving real problems, not just writing code. Recognized for proactivity, I act by anticipating needs and building internal solutions to prevent bottlenecks, ensuring more robust deliverables for the end user."
          },
          {
            "type": "text",
            "text": "Always ready to take on new challenges and master new technologies. Currently, I focus on studying the structured use of Generative AI, LLMs, and automations, integrating tools such as Claude Code, OpenCode, 9Router, and n8n, as well as specification-driven approaches like OpenSpec, to scale productivity while ensuring technical quality in the final product."
          }
        ]
      },
