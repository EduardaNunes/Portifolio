    "label": "AI and Automations",
    "projects": [
      {
        "id": "proj-portfolio",
        "title": "Portfolio",
        "sections": [
          {
            "id": "description",
            "content": [
              {
                "type": "text",
                "text": "In this project, development of a personal portfolio was continued with the aim of serving as a practical laboratory to explore and apply artificial intelligence in structured software engineering."
              },
              {
                "type": "text",
                "text": "More than presenting projects, career paths, and experiences, the initiative explores specification-driven workflows, model routing, and agent assistance to turn requirements into organized, testable, and documented code, maintaining clear criteria for architecture, technical review, and maintainability."
              },
              {
                "type": "text",
                "text": "The proposal seeks to balance productivity with engineering rigor, documenting how AI tools support everything from task planning and UI prototyping to consolidating technical artifacts."
              }
            ]
          },
          {
            "id": "tech",
            "content": [
              {
                "type": "blocks",
                "name": "Tech Stack",
                "items": [
                  "OpenCode CLI",
                  "9router",
                  "OpenSpec",
                  "TypeScript",
                  "React",
                  "Git"
                ]
              }
            ]
          }
